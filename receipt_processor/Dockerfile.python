# Start from an official Python image (3.8+)
FROM python:3.10-slim

# Install Tesseract OCR
RUN apt-get update && apt-get install -y tesseract-ocr && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies from README.md
RUN pip install --no-cache-dir flask pytesseract pillow opencv-python-headless numpy google-generativeai

# Copy the Python app code into the container
COPY . .

# Set FLASK_APP environment variable
ENV FLASK_APP=app.py

# Expose port 5000 (default for Flask)
EXPOSE 5010

# Run the Flask app, binding to 0.0.0.0 to be accessible
# This is the Docker-friendly version of "python app.py"
CMD ["flask", "run", "--host=0.0.0.0", "--port=5010"]