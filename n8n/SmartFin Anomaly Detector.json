    {
      "parameters": {
        "method": "POST",
        "url": "http://smartfin-web/api/n8n/alert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"message\": \"{{ $json.summary }}\", \"severity\": \"{{ $json.severity }}\" }",
        "options": {}
      },
      "id": "afa6e2cd-b580-4920-929a-ed0b8f86796e",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        -624,
        272
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "KFXVAcNPGg1IoGp4",
          "name": "Manager Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = items[0].json;\n\n// Try all known Ollama output locations\nconst content =\n  data.content ??\n  data.text ??\n  data.output ??\n  data.message?.content;\n\nif (content === undefined) {\n  throw new Error(\n    \"AI output missing. Available keys: \" + Object.keys(data).join(\", \")\n  );\n}\n\n// Already parsed object\nif (typeof content === \"object\") {\n  return [{ json: content }];\n}\n\n// String → clean & parse\nif (typeof content === \"string\") {\n  const cleaned = content\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n\n  if (!match) {\n    throw new Error(\"No JSON object found in AI output: \" + cleaned);\n  }\n\n  return [{ json: JSON.parse(match[0]) }];\n}\n\nthrow new Error(\n  \"Unexpected AI output type: \" +\n  Object.prototype.toString.call(content)\n);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1008,
        400
      ],
      "id": "609a1fff-9f3a-489d-9a63-1c74cb1925a1",
      "name": "Parse"
    },
    {
      "parameters": {
        "jsCode": "const data = items[0].json;\n\nif (!data.expenses || !Array.isArray(data.expenses)) {\n  throw new Error(\"Invalid expenses data\");\n}\n\nconst cleaned = data.expenses.map(e => ({\n  id: String(e.id),\n  amount: Number(e.amount),\n  user: String(e.user),\n  category: String(e.category),\n  date: e.date\n}));\n\nreturn [\n  {\n    json: {\n      expenses: cleaned,\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1920,
        400
      ],
      "id": "050cd7d6-40fe-40ca-b893-6edb62edd5ef",
      "name": "Data Normalize"
    },
    {
      "parameters": {
        "jsCode": "const expenses = items[0].json.expenses;\nlet suspicious = false;\n\nconst seen = new Set();\n\nfor (const e of expenses) {\n  // Budget usage above 90%\n  if (e.amount > e.budget_limit * 0.9) {\n    suspicious = true;\n  }\n\n  // Duplicate transaction\n  if (seen.has(e.id)) {\n    suspicious = true;\n  }\n\n  seen.add(e.transaction_id);\n}\n\nreturn [\n  {\n    json: {\n      expenses,\n      suspicious\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1712,
        400
      ],
      "id": "1ec28b58-10c9-4962-b54f-1a6d1e54b699",
      "name": "Rule-based Anomaly Check"
    }
