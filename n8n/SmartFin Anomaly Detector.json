        "messages": {
          "values": [
            {
              "content": "You are a financial anomaly detection system. Respond ONLY in JSON.",
              "role": "assistant"
            },
            {
              "content": "Analyze the following expenses data.\nDetect:\n1. Budget usage above 80%\n2. Duplicate transactions (include user name in it instead of ID)\n3. Unusual spending spikes\n4. Use MYR (RM) only for the currency sign.\n5. Do not include any transaction ID in your output\n\n\nReturn:\n{\n  \"anomaly\": true|false,\n  \"severity\": \"info|warning|critical\",\n  \"summary\": \"concise alert\"\n}",
              "role": "assistant"
            },
            {
              "content": "={{ JSON.stringify($json.expenses) }}"
            }
          ]
        },
        "simplify": false,
        "options": {
          "temperature": 0.6,
          "num_predict": 1024
        }
      },
